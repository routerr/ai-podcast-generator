# AI Podcast Generator Configuration
# Copy this file to .env and fill in your values

# ===================
# LLM Configuration
# ===================

# Provider: "ollama", "openai", or "anthropic"
LLM_PROVIDER=ollama

# Ollama settings (for local LLM)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b
# Alternative: qwen2.5:7b (better for Chinese)

# OpenAI settings (optional fallback)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Anthropic settings (optional fallback)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# ===================
# TTS Configuration
# ===================

# Provider: "edge" (free) or "openai" (paid, higher quality)
TTS_PROVIDER=edge

# OpenAI TTS (if using openai provider)
OPENAI_TTS_MODEL=tts-1-hd

# Edge TTS Voices
EDGE_VOICE_EN_MALE=en-US-GuyNeural
EDGE_VOICE_EN_FEMALE=en-US-JennyNeural
EDGE_VOICE_ZH_MALE=zh-TW-YunJheNeural
EDGE_VOICE_ZH_FEMALE=zh-TW-HsiaoChenNeural

# ===================
# Research Configuration
# ===================

# Provider: "perplexity" (recommended), "tavily", or "duckduckgo" (free)
RESEARCH_PROVIDER=perplexity

# Perplexity API key (get at perplexity.ai/settings/api)
# Models: "sonar" (fast), "sonar-pro" (comprehensive), "sonar-deep-research" (best for podcasts)
PERPLEXITY_API_KEY=
PERPLEXITY_MODEL=sonar-pro

# Tavily API key (alternative, get free tier at tavily.com)
TAVILY_API_KEY=

# ===================
# App Settings
# ===================

DEBUG=true
OUTPUT_DIR=./output
TEMP_DIR=./temp
